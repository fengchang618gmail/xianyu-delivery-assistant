{
  "manifest_version": 3,
  "name": "闲鱼发货助手连接组件",
  "version": "0.2.0",
  "description": "仅在闲鱼卖家聊天页识别待发货订单，并在桌面端确认后协助填入与发送。不读取其他网站。",
  "key": "",
  "permissions": ["storage", "nativeMessaging", "alarms"],
  "host_permissions": ["https://seller.goofish.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://seller.goofish.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
