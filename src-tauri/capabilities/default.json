{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力：事件、通知与外链打开（仅限向导中明确列出的闲鱼/飞书域名）。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://seller.goofish.com/*" },
        { "url": "https://*.goofish.com/*" },
        { "url": "https://*.feishu.cn/*" }
      ]
    }
  ]
}
